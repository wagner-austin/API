#!/bin/sh
# Mirror the commit just made to diphtheria's bare copy of this repository,
# where the corvis wiki services read a clone of it (MCPs board task
# 3952274e). The four wikis under this repository (wiki/, clients/TankpitBot,
# clients/NavProbe, clients/RustedWarfareBot, tools/hpc3) and the code-paths
# audit's workspace mounts are served from that clone, so a page is
# searchable and auditable once it is COMMITTED here, and this hook is what
# makes "committed" mean "mirrored" without a separate step.
#
# THE LOGIC IS NOT IN THIS FILE, exactly as in pre-commit and pre-push: MCPs'
# maketools wiki-mirror-hook makes the push, run as MCPs' origin/main carries
# it (published_maketools.py), and reads this repository's wiki-mirror.* git
# config keys (written by `make wiki-mirror-install` in MCPs). It runs from
# the MCPs checkout so what it did, a failed push above all, is journaled in
# that checkout's .action-events.jsonl, where lock-wake posts a failure to
# whoever committed (MCPs board task b00ab472). It never fails the commit. A
# host with no MCPs checkout beside this one has no mirror role, and says so
# in one line rather than pretending to have pushed.
#
# INSTALLED PER CLONE with the other hooks: `git config core.hooksPath
# .githooks`, or `make install-hooks` from the repository root.

REPO="$(git rev-parse --show-toplevel)"
MCPS="$REPO/../MCPs"
if [ -d "$MCPS/.git" ]; then
    (cd "$MCPS" && python "$REPO/.githooks/published_maketools.py" wiki-mirror-hook commit --repo "$REPO" < /dev/null) \
        || echo "wiki-mirror: wiki-mirror-hook exited $?, so this commit may not be mirrored; $MCPS/.action-events.jsonl says why" >&2
else
    echo "wiki-mirror: $MCPS is not on this host; this commit is not mirrored from here" >&2
fi
