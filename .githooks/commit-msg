#!/bin/sh
# Refuse a commit, before it exists, that names no board task it serves, or
# that weakens a test no upheld test claim licenses.
#
# EVERY COMMIT NAMES ITS TASK (MCPs board task 691b0067, b6eb30c8's R8).
# Work nobody filed is refused rather than logged; the operator,
# 2026-09-26: "no orphaned or unregistered tasks, no exemptions, no
# exceptions. no relaxations, no escape hatches". pre-push refuses such a
# commit too, and a refused commit cannot be repaired without rewriting it,
# so the question is asked here first.
#
# THE LOGIC IS NOT IN THIS FILE, as in pre-commit: MCPs' maketools
# commit-message-tasks reads the message git is about to record ('board task
# <id>' names a task) and asks the board's task_registration, which resolves
# every named id, so a made-up one is refused too. published_maketools.py
# runs it as MCPs' origin/main carries it, never as the MCPs checkout beside
# this one holds it; that checkout supplies the board's credentials and
# address. There is no variable that skips it and no author it exempts, and
# a board that cannot be asked refuses the commit.
#
# THE COMMIT WEAKENS NO TEST UNCLAIMED (MCPs board task 031b2072). A worker
# never deletes, loosens or skips a test to make its change pass; a test it
# believes is wrong is disputed by a TEST CLAIM another session judges, and
# only a claim upheld against that test, on the blob the test file has at
# this commit's HEAD (MCPs board task 34d120aa), licenses weakening it.
# maketools' test-claims reads every 'test claim <id>' the message names off
# the board into the git directory's COMMIT_TEST_CLAIMS, and maketools'
# py-guard runs mcp-shared-py's test-weakening guard on every staged Python
# test file against those claims, refusing with the file, the test and the
# change. Both run as MCPs' origin/main carries them, as the task question
# does; MCPs' own commit-msg runs the same guard at its HEAD.
#
# INSTALLED PER CLONE: `make install-hooks`.

set -eu

REPO="$(git rev-parse --show-toplevel)"
. "$REPO/.githooks/python.sh"
"$HOOK_PYTHON" "$REPO/.githooks/published_maketools.py" commit-message-tasks "$REPO/../MCPs" "$1"
"$HOOK_PYTHON" "$REPO/.githooks/published_maketools.py" test-claims "$REPO/../MCPs" "$1" > "$(git rev-parse --git-dir)/COMMIT_TEST_CLAIMS"
"$HOOK_PYTHON" "$REPO/.githooks/published_maketools.py" py-guard "$REPO/../MCPs" origin/main weakening "$REPO" API "$(git rev-parse --git-dir)/COMMIT_TEST_CLAIMS"
