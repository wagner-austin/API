# The style everything so far was measured under, exactly.
# Matches DEFAULT_DOCTRINE in rw_bot.policy.doctrine -- kept as a file so an
# experiment can start from it by copying one file and editing one line.

name default
goals extractorT1,extractorT1,extractorT1,c_tank,c_tank,c_tank,c_tank
heavies none
max_workers 4

# The shipped AI's sustained wave size ([[engine-ai-triggers]]).
mass 7

# -1 derives the reserve from the composition; a fixed figure holds it still
# across a composition A/B ([[policy-economy]]).
reserve -1

expand 1
counter 0
navtilt 0
cover 1
intercept 0
guard_cap 0
aa_cover 0
forward 0
scout 0
raid 0
rush 0
creep 0
riposte 0
kite 0
tech 0
lurk 0
allin 0
strike 0
medics 0
decoys 0
hp_floor 0
bunkers 0
flame 0
close 0
income_ladder 0
guns 0
nukes 0
