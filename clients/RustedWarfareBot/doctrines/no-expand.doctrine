# The control arm of the expansion A/B: the old fixed economy, one line away
# from default ([[policy-economy]]). Replaces the CLI's positional `expand 0`.

name no-expand
goals extractorT1,extractorT1,extractorT1,c_tank,c_tank,c_tank,c_tank
heavies none
max_workers 4
mass 7
reserve -1
expand 0
counter 0
navtilt 0
cover 1
intercept 0
guard_cap 0
aa_cover 0
forward 0
scout 0
raid 0
rush 0
creep 0
hold 0
riposte 0
kite 0
tech 0
lurk 0
allin 0
strike 0
medics 0
navy 0
battery 0
decoys 0
hp_floor 0
bunkers 0
flame 0
close 0
income_ladder 0
guns 0
nukes 0
rebuild 0
hunt 0
brace 0
huntgate 0
bank 0
