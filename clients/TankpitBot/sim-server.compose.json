{
  "name": "tankpit-sim",
  "services": {
    "sim": {
      "image": "${SIM_IMAGE:?sim.env must name the sim image}",
      "command": [
        "tankpit-sim-serve",
        "--database-env",
        "TANKPIT_SIM_DATABASE_URL",
        "--bind",
        "0.0.0.0",
        "--port",
        "8765",
        "--room",
        "1:field01:p",
        "--room",
        "5:field05:n",
        "--web-root",
        "/app/web"
      ],
      "environment": {
        "TANKPIT_SIM_DATABASE_URL": "postgresql://tankpit_sim:${SIM_DB_PASSWORD:?sim.env must set SIM_DB_PASSWORD}@sim-db:5432/tankpit_sim"
      },
      "ports": [
        "127.0.0.1:8765:8765"
      ],
      "depends_on": {
        "sim-db": {
          "condition": "service_healthy"
        }
      },
      "stop_grace_period": "15s",
      "restart": "no"
    },
    "sim-db": {
      "image": "postgres:16-bookworm",
      "environment": {
        "POSTGRES_DB": "tankpit_sim",
        "POSTGRES_USER": "tankpit_sim",
        "POSTGRES_PASSWORD": "${SIM_DB_PASSWORD:?sim.env must set SIM_DB_PASSWORD}"
      },
      "volumes": [
        "sim-db:/var/lib/postgresql/data"
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "pg_isready -U tankpit_sim -d tankpit_sim"
        ],
        "interval": "5s",
        "timeout": "5s",
        "retries": 12
      },
      "restart": "no"
    }
  },
  "volumes": {
    "sim-db": {}
  }
}
