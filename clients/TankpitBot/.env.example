# TankpitBot Configuration
# Copy to .env and customize

# Sniffer settings
TANKPIT_URL=https://tankpit.com/play
# TANKPIT_OUTPUT overrides the capture destination. Leave unset so captures
# land at the canonical runs/sniff/latest.capture_session.json (+ archive).
# TANKPIT_OUTPUT=
TANKPIT_HEADLESS=false
TANKPIT_DURATION_MS=0
TANKPIT_LIVE_DECODE=true
TANKPIT_PREFER_ACCOUNT=false

# Probe settings
TANKPIT_PROBE_OUTPUT=probe_session.json
TANKPIT_WAIT_JOIN_MS=5000
TANKPIT_WAIT_INPUT_MS=1000

# Account selection (uses accounts.json for the account list)
# Select by name: TANKPIT_ACCOUNT=Artax
# Select by index (for fleet): TANKPIT_ACCOUNT=0, TANKPIT_ACCOUNT=1, etc.
# TANKPIT_ACCOUNT=
# Override (bypasses accounts.json): set both TANKPIT_USERNAME and TANKPIT_PASSWORD
# TANKPIT_USERNAME=
# TANKPIT_PASSWORD=
#
# REQUIRED when running in the container (docker-compose.yml). These two
# are the only credential route that survives installation: accounts.json
# is found via a path computed relative to the module, which is the
# package root in a source checkout and site-packages once pip has
# installed the wheel. So TANKPIT_ACCOUNT selection and the
# first-account default above do NOT work in the image.

# Windows console UTF-8 support
PYTHONUTF8=1
