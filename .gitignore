# =============================================================================
# Root .gitignore for API Monorepo
# =============================================================================

# Models
*.ubj
services/covenant-radar-api/models/*.pt
services/covenant-radar-api/models/xgboost/
services/covenant-radar-api/models/lightgbm/
services/covenant-radar-api/models/mlp/
services/covenant-radar-api/models/lstm/
services/covenant-radar-api/models/optimization_history.jsonl

# Python
__pycache__/
*.py[cod]
*$py.class
.Python
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
coverage_output.txt
mypy_errors.txt
htmlcov/

# Virtual environments
env/
venv/
.venv/

# Environment files (allow examples)
.env
.env.*
!.env.example

# Build and packaging
build/
dist/
*.egg-info/
*.egg
*.whl

# Compiled Python extensions and their debug symbols.
# maturin writes these into the SOURCE tree (cleargbm_rs sets
# python-source = "python", so `maturin develop` drops the artifacts next to
# __init__.py, which build/ and target/ do not cover). They must not be
# committed: cleargbm_rs builds with -C target-cpu=native, so the binary is
# not portable across CPU generations, and every consumer installs from the
# maturin wheel or a develop path-dep rather than from these files.
*.pyd
*.so
*.pdb

# Logs
logs/
*.log

# OS/IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# Jupyter
.ipynb_checkpoints/

# Caches
.cache/
.python-version

# Claude Code
.claude/

# Gemini
.gemini/

# Data directories (each service manages its own)
**/data/
# Allow covenant-radar-api external datasets to be versioned for tests/benchmarks
!services/covenant-radar-api/data/
!services/covenant-radar-api/data/external/
!services/covenant-radar-api/data/external/**
# Exclude large Kaggle datasets (>50MB, use kaggle CLI to download)
# rw_matches is locally generated rather than downloaded -- the RustedWarfare
# match fleet writes it -- but data.csv is 64MB, over the same threshold, and
# it is reproducible by re-running matches. Same rule, different source.
services/covenant-radar-api/data/external/rw_matches/
# rw_value derives deterministically from rw_matches (covenant_ml's
# scripts/derive_rw_value.py) and is the same size class. Same rule.
services/covenant-radar-api/data/external/rw_value/
services/covenant-radar-api/data/external/kaggle_amex_default/
services/covenant-radar-api/data/external/kaggle_lending_club/
services/covenant-radar-api/data/external/kaggle_home_credit/
services/covenant-radar-api/data/external/kaggle_credit_card_fraud/
services/covenant-radar-api/data/external/kaggle_sba_loans/
services/covenant-radar-api/data/external/kaggle_risk_analytics/
services/covenant-radar-api/data/external/kaggle_prosper_loans/
**/datasets/
# But allow source code directories named "datasets"
!**/src/**/datasets/
!**/tests/**/datasets/
**/outputs/
**/checkpoints/
**/corpus_cache/
**/artifacts/
**/runs/
**/corpus/

# But allow source code directories named "data"
!**/src/**/data/
!**/tests/**/data/

# HuggingFace cache
hf-cache/

# Docker
.docker/

# Windows artifacts
nul
*.tmp

# Test artifacts at root (from manual testing)
/model-*/
/*.png
/*.txt
/*.tar.xz
!README.md
!AGENTS.md
!docs/**/*.md

# Node (if any JS tooling)
node_modules/

# Web frontend build output
services/grandma-api/web/assets/js/
services/grandma-api/web/coverage/

# TankpitBot captured sessions and runtime data (regeneratable)
clients/TankpitBot/capture_session.json
clients/TankpitBot/raw_capture.json
clients/TankpitBot/messages_dump.txt
clients/TankpitBot/session_summary.json
clients/TankpitBot/mine_place.json
# pytest basetemp: .pytest_tmp is the configured one (pyproject addopts);
# the glob also covers per-session overrides like --basetemp .pytest_tmp_mine,
# which exist because pytest wipes basetemp at startup and two concurrent
# `make check` runs would corrupt each other through the shared default.
clients/TankpitBot/.pytest_tmp*/
# TankpitBot credentials (real passwords, never commit)
clients/TankpitBot/accounts.json
# Rust
target/
Cargo.lock
*.lcov
coverage.lcov
# LLVM coverage output (cargo llvm-cov)
cov_*.json
cov_*.txt
coverage*.json
coverage*.txt
coverage_html/

# Claude temp directories
tmpclaude-*

# Local-machine compose override. Content is host-port remapping (platform-postgres
# on 55432 because the MCPs stack owns 5432), so it is per-machine by definition.
docker-compose.override.yml

# Derived vector index for a wiki (hnsw.index + metadata), rebuilt from the
# wiki content on demand. No chroma store is tracked anywhere in this repo.
#
# Unanchored on purpose. The previous pattern was "wiki/.chroma/", and a
# pattern with an embedded slash is anchored to this file's directory, so it
# only ever matched the root wiki and never the per-client ones under
# clients/*/wiki/. Three client stores escaped it and one of them reached a
# commit, which is 419KB of binary index rewritten on every reindex.
.chroma/
