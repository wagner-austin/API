clients/TankpitBot/messages_dump.txt
clients/TankpitBot/session_summary.json
clients/TankpitBot/mine_place.json
# pytest basetemp: .pytest_tmp is the configured one (pyproject addopts);
# the glob also covers per-session overrides like --basetemp .pytest_tmp_mine,
# which exist because pytest wipes basetemp at startup and two concurrent
# `make check` runs would corrupt each other through the shared default.
clients/TankpitBot/.pytest_tmp*/
# TankpitBot credentials (real passwords, never commit)
clients/TankpitBot/accounts.json
# Rust
target/
Cargo.lock
*.lcov
coverage.lcov
# LLVM coverage output (cargo llvm-cov)
cov_*.json
cov_*.txt
coverage*.json
coverage*.txt
coverage_html/

# Claude temp directories
tmpclaude-*

# Local-machine compose override. Content is host-port remapping (platform-postgres
# on 55432 because the MCPs stack owns 5432), so it is per-machine by definition.
docker-compose.override.yml

# Derived vector index for a wiki (hnsw.index + metadata), rebuilt from the
# wiki content on demand. No chroma store is tracked anywhere in this repo.
#
# Unanchored on purpose. The previous pattern was "wiki/.chroma/", and a
# pattern with an embedded slash is anchored to this file's directory, so it
# only ever matched the root wiki and never the per-client ones under
# clients/*/wiki/. Three client stores escaped it and one of them reached a
# commit, which is 419KB of binary index rewritten on every reindex.
.chroma/
