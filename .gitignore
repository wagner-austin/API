# =============================================================================
# Root .gitignore for API Monorepo
# =============================================================================

# Models
*.ubj
services/covenant-radar-api/models/*.pt
services/covenant-radar-api/models/xgboost/
services/covenant-radar-api/models/lightgbm/
services/covenant-radar-api/models/mlp/
services/covenant-radar-api/models/lstm/
services/covenant-radar-api/models/optimization_history.jsonl

# Python
__pycache__/
*.py[cod]
*$py.class
.Python
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
coverage_output.txt
htmlcov/

# Virtual environments
env/
venv/
.venv/

# Environment files (allow examples)
.env
.env.*
!.env.example

# Build and packaging
build/
dist/
*.egg-info/
*.egg
*.whl

# Logs
logs/
*.log

# OS/IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# Jupyter
.ipynb_checkpoints/

# Caches
.cache/
.python-version

# Claude Code
.claude/

# Gemini
.gemini/

# Data directories (each service manages its own)
**/data/
# Allow covenant-radar-api external datasets to be versioned for tests/benchmarks
!services/covenant-radar-api/data/
!services/covenant-radar-api/data/external/
!services/covenant-radar-api/data/external/**
# Exclude large Kaggle datasets (>50MB, use kaggle CLI to download)
services/covenant-radar-api/data/external/kaggle_amex_default/
services/covenant-radar-api/data/external/kaggle_lending_club/
services/covenant-radar-api/data/external/kaggle_home_credit/
services/covenant-radar-api/data/external/kaggle_credit_card_fraud/
services/covenant-radar-api/data/external/kaggle_sba_loans/
services/covenant-radar-api/data/external/kaggle_risk_analytics/
services/covenant-radar-api/data/external/kaggle_prosper_loans/
**/datasets/
**/outputs/
**/checkpoints/
**/corpus_cache/
**/artifacts/
**/runs/
**/corpus/

# But allow source code directories named "data"
!**/src/**/data/
!**/tests/**/data/

# HuggingFace cache
hf-cache/

# Docker
.docker/

# Windows artifacts
nul
*.tmp

# Test artifacts at root (from manual testing)
/model-*/
/*.png
/*.txt
/*.tar.xz
!README.md
!AGENTS.md
!docs/**/*.md

# Node (if any JS tooling)
node_modules/
