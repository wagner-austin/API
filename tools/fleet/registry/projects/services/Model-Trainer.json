{
  "worker_ram_gb": 1.1,
  "minimum_workers": 6,
  "expected_minutes": 4,
  "required_tags": [
    "gpu"
  ],
  "source": {
    "remote": "https://github.com/wagner-austin/API.git",
    "path": "services/Model-Trainer",
    "install": [
      {
        "phase": "deps",
        "argv": [
          "poetry",
          "-C",
          "services/Model-Trainer",
          "lock"
        ]
      },
      {
        "phase": "deps",
        "argv": [
          "poetry",
          "-C",
          "services/Model-Trainer",
          "sync",
          "--no-cache",
          "--with",
          "dev"
        ]
      }
    ],
    "companions": []
  }
}
