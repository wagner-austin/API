{
  "worker_ram_gb": 1.6,
  "minimum_workers": 2,
  "expected_minutes": 16,
  "required_tags": [
    "rust"
  ],
  "source": {
    "remote": "https://github.com/wagner-austin/API.git",
    "path": "services/covenant-radar-api",
    "install": [
      {
        "phase": "deps",
        "argv": [
          "poetry",
          "-C",
          "services/covenant-radar-api",
          "lock"
        ]
      },
      {
        "phase": "deps",
        "argv": [
          "poetry",
          "-C",
          "services/covenant-radar-api",
          "sync",
          "--no-cache",
          "--with",
          "dev"
        ]
      }
    ],
    "companions": []
  }
}
