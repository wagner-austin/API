{
  "worker_ram_gb": 1.0,
  "minimum_workers": 4,
  "expected_minutes": 60,
  "required_tags": [
    "linux",
    "docker"
  ],
  "source": {
    "remote": "https://github.com/wagner-austin/API.git",
    "path": "tools/maketools-execution",
    "install": [
      {
        "phase": "image-github-stats-api",
        "argv": [
          "make",
          "-C",
          "tools/maketools-execution",
          "image-github-stats-api"
        ]
      },
      {
        "phase": "image-grandma-api",
        "argv": [
          "make",
          "-C",
          "tools/maketools-execution",
          "image-grandma-api"
        ]
      },
      {
        "phase": "image-opportunity-radar-api",
        "argv": [
          "make",
          "-C",
          "tools/maketools-execution",
          "image-opportunity-radar-api"
        ]
      },
      {
        "phase": "image-transcript-api",
        "argv": [
          "make",
          "-C",
          "tools/maketools-execution",
          "image-transcript-api"
        ]
      }
    ],
    "companions": []
  }
}
