{
  "worker_ram_gb": 0.5,
  "minimum_workers": 2,
  "expected_minutes": 10,
  "required_tags": [
    "cxx",
    "pdftotext"
  ],
  "source": {
    "remote": "https://github.com/wagner-austin/MCPs.git",
    "path": "packages/wiki-check",
    "install": [
      {
        "phase": "install",
        "argv": [
          "make",
          "-s",
          "-C",
          "scripts/fleet-prepare",
          "install"
        ]
      },
      {
        "phase": "workspace-build",
        "argv": [
          "make",
          "-s",
          "-C",
          "scripts/fleet-prepare",
          "workspace-build"
        ]
      },
