{
  "worker_ram_gb": 1.0,
  "minimum_workers": 1,
  "expected_minutes": 30,
  "exclusive_resources": [
    "netboot-http-8780"
  ],
  "required_tags": [
    "linux",
    "cxx"
  ],
  "node": "diphtheria",
  "source": {
    "remote": "https://github.com/wagner-austin/MCPs.git",
    "path": "execution",
    "install": [
      {
        "phase": "install",
        "argv": [
          "make",
          "-s",
          "-C",
          "scripts/fleet-prepare",
          "install"
        ]
      },
      {
        "phase": "workspace-build",
        "argv": [
          "make",
          "-s",
          "-C",
          "scripts/fleet-prepare",
          "workspace-build"
        ]
      },
      {
        "phase": "netboot-lane",
        "argv": [
          "make",
          "-s",
          "-C",
          "scripts/fleet-prepare",
          "netboot-lane",
          "ENV_FILE=/home/corvis/PROJECTS/MCPs/.env"
        ]
      }
    ],
    "companions": []
  }
}
