{
  "worker_ram_gb": 0.5,
  "minimum_workers": 1,
  "expected_minutes": 5,
  "required_tags": [
    "linux",
    "cxx"
  ],
  "node": "diphtheria",
  "source": {
    "remote": "https://github.com/wagner-austin/MCPs.git",
    "path": "execution",
    "install": [
      {
        "phase": "install",
        "argv": [
          "make",
          "-s",
          "-C",
          "scripts/fleet-prepare",
          "install"
        ]
      },
      {
        "phase": "workspace-build",
        "argv": [
          "make",
          "-s",
          "-C",
          "scripts/fleet-prepare",
          "workspace-build"
        ]
      },
      {
        "phase": "deployed-lane",
        "argv": [
          "make",
          "-s",
          "-C",
          "scripts/fleet-prepare",
          "deployed-lane"
        ]
      }
    ],
    "companions": []
  }
}
