{
  "worker_ram_gb": 1.5,
  "minimum_workers": 3,
  "expected_minutes": 90,
  "required_tags": [
    "linux",
    "docker"
  ],
  "source": {
    "remote": "https://github.com/wagner-austin/MCPs.git",
    "path": "execution",
    "install": [
      {
        "phase": "install",
        "argv": [
          "npm",
          "ci",
          "--ignore-scripts"
        ]
      },
      {
        "phase": "workspace-build",
        "argv": [
          "node",
          "scripts/ci-build-consumed-workspaces.mjs",
          "execution",
          "mcp-proxy"
        ]
      },
      {
        "phase": "workspace-build",
        "argv": [
          "npm",
          "rebuild",
          "mcp-shared"
        ]
      }
    ],
    "companions": []
  }
}
