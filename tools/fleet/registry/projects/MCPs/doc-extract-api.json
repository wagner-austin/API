{
  "worker_ram_gb": 0.3,
  "minimum_workers": 3,
  "expected_minutes": 8,
  "exclusive_resources": [
    "corvis-fleet-testdb"
  ],
  "required_tags": [
    "testdb",
    "cxx",
    "stack"
  ],
  "source": {
    "remote": "https://github.com/wagner-austin/MCPs.git",
    "path": "doc-extract-api",
    "install": [
      {
        "phase": "install",
        "argv": [
          "make",
          "-s",
          "-C",
          "scripts/fleet-prepare",
          "install"
        ]
      },
      {
        "phase": "workspace-build",
        "argv": [
          "make",
          "-s",
          "-C",
          "scripts/fleet-prepare",
          "workspace-build"
        ]
      },
      {
        "phase": "test-database",
        "argv": [
          "make",
          "-s",
          "-C",
          "scripts/fleet-prepare",
          "test-database",
          "CONTAINER=corvis-fleet-testdb"
        ]
      }
    ],
    "companions": []
  }
}
