{
  "worker_ram_gb": 0.5,
  "minimum_workers": 1,
  "expected_minutes": 10,
  "required_tags": ["linux", "cxx"],
  "node": "diphtheria",
  "exclusive_resources": ["corvis-phone-device-tests"],
  "source": {
    "remote": "https://github.com/wagner-austin/MCPs.git",
    "path": "execution/phone",
    "install": [
      {"phase": "install", "argv": ["npm", "ci", "--ignore-scripts"]},
      {"phase": "workspace-build", "argv": ["node", "scripts/ci-build-consumed-workspaces.mjs", "execution"]},
      {"phase": "workspace-build", "argv": ["npm", "rebuild", "mcp-shared"]}
    ],
    "companions": []
  }
}
