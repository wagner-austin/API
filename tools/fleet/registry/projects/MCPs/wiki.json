{
  "worker_ram_gb": 0.5,
  "minimum_workers": 1,
  "expected_minutes": 5,
  "required_tags": [
    "cxx"
  ],
  "source": {
    "remote": "https://github.com/wagner-austin/MCPs.git",
    "path": "wiki",
    "install": [
      {
        "phase": "install",
        "argv": [
          "make",
          "-s",
          "-C",
          "scripts/fleet-prepare",
          "install"
        ]
      },
      {
        "phase": "wiki-search-build",
        "argv": [
          "node",
          "scripts/ci-build-consumed-workspaces.mjs",
          "packages/wiki-search"
        ]
      }
    ],
    "companions": []
  }
}
