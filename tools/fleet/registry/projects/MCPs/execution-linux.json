{
  "worker_ram_gb": 0.5,
  "minimum_workers": 3,
  "expected_minutes": 10,
  "required_tags": [
    "linux"
  ],
  "source": {
    "remote": "https://github.com/wagner-austin/MCPs.git",
    "path": "execution",
    "install": [
      {
        "phase": "install",
        "argv": [
          "make",
          "-s",
          "-C",
          "scripts/fleet-prepare",
          "install"
        ]
      },
      {
        "phase": "workspace-build",
        "argv": [
          "make",
          "-s",
          "-C",
          "scripts/fleet-prepare",
          "workspace-build",
          "ROOTS=execution:mcp-proxy"
        ]
      }
    ],
    "companions": []
  }
}
