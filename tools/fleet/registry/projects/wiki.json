{
  "worker_ram_gb": 2,
  "minimum_workers": 1,
  "expected_minutes": 10,
  "exclusive_resources": [
    "corvis-fleet-testdb"
  ],
  "required_tags": [
    "testdb",
    "cxx",
    "pdftotext"
  ],
  "source": {
    "remote": "https://github.com/wagner-austin/wiki.git",
    "path": "",
    "install": [
      {
        "phase": "mcps-install",
        "argv": [
          "make",
          "-s",
          "--directory=../MCPs/scripts/fleet-prepare",
          "install"
        ]
      },
      {
        "phase": "mcps-build",
        "argv": [
          "make",
          "-s",
          "--directory=../MCPs/scripts/fleet-prepare",
          "workspace-build",
          "ROOTS=packages/db:packages/wiki-check:packages/wiki-cli"
        ]
      },
      {
        "phase": "test-database",
        "argv": [
          "make",
          "-s",
          "--directory=../MCPs/scripts/fleet-prepare",
          "test-database",
          "CONTAINER=corvis-fleet-testdb"
        ]
      },
      {
        "phase": "install",
        "argv": [
          "npm",
          "ci"
        ]
      }
    ],
    "companions": [
      {
        "remote": "https://github.com/wagner-austin/MCPs.git",
        "ref": "main",
        "directory": "MCPs"
      }
    ]
  }
}
