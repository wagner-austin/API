# Google Calendar OAuth Credentials (from Google Cloud Console)
# Get these from: https://console.cloud.google.com/apis/credentials
# Required for automatic token refresh
GOOGLE_CALENDAR_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CALENDAR_CLIENT_SECRET=GOCSPX-your_secret
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost

# =============================================================================
# Account 1: Personal (default account)
# =============================================================================
# Run: poetry run python -c "from platform_calendar import load_or_authorize; print(load_or_authorize())"
GOOGLE_CALENDAR_ACCESS_TOKEN=ya29.your_access_token
GOOGLE_CALENDAR_REFRESH_TOKEN=1//your_refresh_token
GOOGLE_CALENDAR_TOKEN_EXPIRES_AT=1735200000

# =============================================================================
# Account 2: Interns (optional additional account)
# =============================================================================
# GOOGLE_CALENDAR_INTERNS_ACCESS_TOKEN=ya29.interns_access_token
# GOOGLE_CALENDAR_INTERNS_REFRESH_TOKEN=1//interns_refresh_token
# GOOGLE_CALENDAR_INTERNS_EXPIRES_AT=1735200000

# =============================================================================
# Token Refresh
# =============================================================================
# The CLI automatically refreshes expired access tokens using the refresh token.
# - ACCESS_TOKEN: Short-lived (1 hour), refreshed automatically
# - REFRESH_TOKEN: Long-lived, used to get new access tokens
# - EXPIRES_AT: Unix timestamp when access token expires
