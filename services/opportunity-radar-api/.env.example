# Kaggle API Token (get from https://www.kaggle.com/settings -> API)
KAGGLE_API_TOKEN=your_kaggle_api_token_here

# GitHub settings for codebase scanning (optional, but required in Docker)
# When deployed to Railway/Docker, the service uses GitHub API to scan the repo
# instead of local filesystem since libs/ directory isn't in the container.
GITHUB_TOKEN=your_github_token_here
GITHUB_REPO=owner/repo
