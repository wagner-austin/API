# Uzbek (Cyrillic) → IPA transliteration rules (uzc_ipa.rules)
#
# Source-Authors: Ido, S.
# Source-Year: 2025
# Source-Title: Uzbek
# Source-Container: Journal of the International Phonetic Association 55(1-2): 152-168
# Source-Id: https://doi.org/10.1017/S0025100324000148
#
# Basis: Standard/Tashkent Uzbek, modern Cyrillic orthography.
# Ў = oʻ, Ғ = gʻ. Russian-only letters kept minimal; hard/soft signs treated phonemically.

# ---------------------------------------------------------------------------
# Macros (orthographic)
# ---------------------------------------------------------------------------

$V_cyr = [А Е Ё И О Ў У Э Ю Я а е ё и о ў у э ю я] ;

# Vowels as this file writes them. A left context is matched against text
# that has already been transliterated, so a rule looking leftwards for a
# vowel has to name the IPA symbol rather than the Cyrillic letter.
$Vout = [a e i ɔ o u ø y ɪ ʊ æ ɨ] ;

# ---------------------------------------------------------------------------
# Digraphs / multi-letter sequences
# ---------------------------------------------------------------------------

# ‹нг› is usually /ŋ/ in Uzbek (native and many loans)
нг > ŋ ;
НГ > ŋ ;
Нг > ŋ ;
нГ > ŋ ;

# ‹тс› often realized as /t͡s/ in loans
тс > t͡s ;
ТС > t͡s ;
Тс > t͡s ;
тС > t͡s ;

ч > t͡ʃ ;
Ч > t͡ʃ ;

ш > ʃ ;
Ш > ʃ ;

# ---------------------------------------------------------------------------
# ‹Е е›: je vs e (word-initial / after vowel / Ъ / Ь)
# ---------------------------------------------------------------------------

# The contextual rules come before the word-initial one because ICU's
# rule-masking check does not model the ^ anchor: it reads an anchored
# rule as having no left context at all, so an earlier ^ rule looks
# general enough to hide every contextual rule for the same letter and
# the file will not compile.

# After vowels. Written with the Cyrillic set these never matched, and
# because the bracket was the right-context one they replaced the
# preceding vowel instead of the ‹е›.
$Vout { Е > je ;
$Vout { е > je ;

# After hard/soft signs, which this file writes as ʔ and ʲ
[ʔ ʲ] { Е > je ;
[ʔ ʲ] { е > je ;

# Word-initial
^ Е > je ;
^ е > je ;

# Default
Е > e ;
е > e ;

# ---------------------------------------------------------------------------
# Other iotated vowels
# ---------------------------------------------------------------------------

# Matches О/о above, not Ў/ў: the Cyrillic ё carries the open vowel.
Ё > jɔ ;  ё > jɔ ;
Ю > ju ;  ю > ju ;
Я > ja ;  я > ja ;

# ---------------------------------------------------------------------------
# Core letters
# ---------------------------------------------------------------------------

А > a ;  а > a ;
Б > b ;  б > b ;
В > v ;  в > v ;
Г > ɡ ;  г > ɡ ;
Ғ > ʁ ;  ғ > ʁ ;      # gʻ
Д > d ;  д > d ;

# ‹Ж ж› corresponds to Latin ‹j›, phonemic affricate. The second
# element is voiced: a voiced stop tied to a voiceless fricative is
# not a producible segment, and the Latin rules already write the
# voiced affricate for the same phoneme.
Ж > d͡ʒ ; ж > d͡ʒ ;

З > z ;  з > z ;

# И writes both /i/ and more central [ɘ ~ ɨ]; we map to [i] by default.
И > i ;  и > i ;

Й > j ;  й > j ;
К > k ;  к > k ;
Қ > q ;  қ > q ;
Л > l ;  л > l ;
М > m ;  м > m ;
Н > n ;  н > n ;

# ‹О› ≈ /O/ (open-mid, weak rounding); here [ɔ]
О > ɔ ;  о > ɔ ;

# Ў = oʻ, close-mid back rounded /o/
Ў > o ;  ў > o ;

П > p ;  п > p ;
Р > r ;  р > r ;
С > s ;  с > s ;
Т > t ;  т > t ;
У > u ;  у > u ;
Ф > f ;  ф > f ;

# /X/ – voiceless (velar/uvular) fricative
Х > x ;  х > x ;

# /h/ – glottal fricative
Ҳ > h ;  ҳ > h ;

Ц > t͡s ; ц > t͡s ;

# ---------------------------------------------------------------------------
# Hard/soft signs and loan punctuation letters
# ---------------------------------------------------------------------------

Ъ > ʔ ;  ъ > ʔ ;      # treated as glottal stop in loans / boundary marker
Ь > ʲ ;  ь > ʲ ;      # palatalization marker in some loans
Э > e ;  э > e ;

# ---------------------------------------------------------------------------
# Letters outside the Uzbek Cyrillic alphabet
#
# None of these is an Uzbek letter. They reach an Uzbek Cyrillic corpus in
# Russian text or in quoted material from the neighbouring Turkic
# languages. Without a rule they passed through as Cyrillic into what is
# supposed to be IPA, which is the one outcome that is certainly wrong.
#
# The Russian letters take their Russian values, as <ъ>, <ь> and <ц> above
# already do. The Turkic ones take the value our own sourced rule file
# gives them for the language that owns the letter. Kazakh and Kyrgyz
# disagree on the height of the two front rounded vowels, and a letter of
# indeterminate origin cannot settle that, so <ө> and <ү> take the cardinal
# symbols Kyrgyz uses rather than the reduced ones Kazakh uses.
# ---------------------------------------------------------------------------
Ы > ɨ ;  ы > ɨ ;      # Russian
# Russian loan letter, written with the postalveolar rather than the
# alveolo-palatal this file used to emit. symbol_map.csv already records
# that this project writes Uzbek's alveolo-palatal series as t͡ʃ/ʃ.
Щ > ʃː ; щ > ʃː ;
Ѳ > θ ;  ѳ > θ ;      # FITA, Greek theta loans
І > ɪ ;  і > ɪ ;      # Kazakh; kk_ipa.rules (McCollum & Chen 2021)
Ұ > ʊ ;  ұ > ʊ ;      # Kazakh; kk_ipa.rules
Ә > æ ;  ә > æ ;      # Kazakh; kk_ipa.rules
Һ > h ;  һ > h ;      # Kazakh; kk_ipa.rules
Ң > ŋ ;  ң > ŋ ;      # Kazakh and Kyrgyz agree
Ҥ > ŋ ;  ҥ > ŋ ;      # EN WITH TAIL, velar nasal; ky_ipa.rules
Ө > ø ;  ө > ø ;      # Kyrgyz; ky_ipa.rules (McCollum 2020)
Ү > y ;  ү > y ;      # Kyrgyz; ky_ipa.rules

:: NFC ;
