# Uzbek (Latin) → IPA transliteration rules (uz_ipa.rules)
#
# Source-Authors: Ido, S.
# Source-Year: 2025
# Source-Title: Uzbek
# Source-Container: Journal of the International Phonetic Association 55(1-2): 152-168
# Source-Id: https://doi.org/10.1017/S0025100324000148
#
# Basis: Standard/Tashkent Uzbek.
# Segmental only: no stress, no vowel deletion, no automatic /i ~ ɘ/ split.
# Orthography: Official Uzbek Latin (sh, ch, ng, gʻ, oʻ).
#
# Corroborated: Boeschoten, H. (2021) 'Uzbek', in Johanson & Csató
# (eds.), The Turkic Languages, 2nd ed., Routledge, 388-408
# (https://doi.org/10.4324/9781003243809-25). His consonant table
# (p. 390) matches this file; his å [ɒ] is the open value of plain <o>;
# the spelling's front/back mergers (p. 389) are the reduction Ido's
# inventory encodes. One divergence: he lists the labial as w where Ido
# (2025) gives /v/; this file follows Ido.

# ---------------------------------------------------------------------------
# Macros (orthographic)
# ---------------------------------------------------------------------------

$Apo    = [ʼ ' ‘ ’ ʻ ʾ] ;          # apostrophe-like marks used in oʻ, gʻ, loans

# ---------------------------------------------------------------------------
# Multi-character sequences and digraphs
# ---------------------------------------------------------------------------

# ng, sh, ch, ts are treated as single segments

ng  > ŋ ;
NG  > ŋ ;
Ng  > ŋ ;
nG  > ŋ ;

sh  > ʃ ;
SH  > ʃ ;
Sh  > ʃ ;
sH  > ʃ ;

ch  > t͡ʃ ;
CH  > t͡ʃ ;
Ch  > t͡ʃ ;
cH  > t͡ʃ ;

ts  > t͡s ;
TS  > t͡s ;
Ts  > t͡s ;
tS  > t͡s ;

# ---------------------------------------------------------------------------
# ‹yo / yu / ya / ye› sequences (mostly in loans)
# ---------------------------------------------------------------------------

# The vowel here is the one plain <o> carries, not the one <oʻ>
# does: Ido gives yol 'mane' as /jɔl/ (p. 154). Writing <o> instead
# put the close vowel on every <yo> in the corpus.
yo  > jɔ ;
Yo  > jɔ ;
YO  > jɔ ;

yu  > ju ;
Yu  > ju ;
YU  > ju ;

ya  > ja ;
Ya  > ja ;
YA  > ja ;

ye  > je ;
Ye  > je ;
YE  > je ;

# ---------------------------------------------------------------------------
# Letters with apostrophe: oʻ, gʻ
# ---------------------------------------------------------------------------

# oʻ (written o + apostrophe) – close-mid back rounded /o/
o $Apo  > o ;
O $Apo  > o ;

# gʻ – voiced uvular fricative
g $Apo  > ʁ ;
G $Apo  > ʁ ;

# ---------------------------------------------------------------------------
# Vowels (simple one-to-one mapping)
# ---------------------------------------------------------------------------

a > a ;    A > a ;
e > e ;    E > e ;

# ‹o› is /O/, typically open-mid, often somewhat backed; here simplified to [ɔ]
o > ɔ ;    O > ɔ ;

u > u ;    U > u ;

# ‹i› writes both /i/ and /ɘ ~ ɨ/. We keep [i] as the neutral phonemic value.
i > i ;    I > i ;

# ---------------------------------------------------------------------------
# Consonants
# ---------------------------------------------------------------------------

b > b ;    B > b ;
v > v ;    V > v ;
g > ɡ ;    G > ɡ ;         # plain g (not gʻ)
d > d ;    D > d ;

# ‹j› = alveolopalatal affricate (dpý) – here rendered [d͡ʒ]
j > d͡ʒ ;  J > d͡ʒ ;

z > z ;    Z > z ;

# ‹y› is the palatal glide /j/
y > j ;    Y > j ;

k > k ;    K > k ;
q > q ;    Q > q ;
l > l ;    L > l ;
m > m ;    M > m ;
n > n ;    N > n ;
p > p ;    P > p ;
r > r ;    R > r ;
s > s ;    S > s ;
t > t ;    T > t ;
f > f ;    F > f ;

# /X/ – voiceless velar (often slightly uvular) fricative
x > x ;    X > x ;

# /h/ – glottal fricative (often [x]-like in casual Tashkent speech)
h > h ;    H > h ;


:: NFC ;
