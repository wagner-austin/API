*.py[cod]
*$py.class
.Python
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Virtual environments and env files
env/
venv/
.venv/
.env
.env.*
!.env.example

# Build and packaging
build/
dist/
*.egg-info/

# Logs
logs/
*.log

# OS/IDE
.DS_Store
Thumbs.db
.idea/
.vscode/

# Jupyter
.ipynb_checkpoints/

# Caches
.cache/
.python-version

# Project-specific
.claude/
data/
datasets/
outputs/
checkpoints/
corpus_cache/
*.json

# Allow the archived cartridge RunRecords: their sha256s are quoted as
# certificates in docs/RESEARCH.md and the api-codebase wiki, so the files
# themselves must live where any checkout can verify them (2026-09-09).
!results/cartridge/*.json

# Allow type stubs under typings even if named like ignored dirs
!typings/datasets/
!typings/torch/utils/data/

# Allow source code under services/data (code directory named "data")
!src/model_trainer/core/services/data/
!tests/core/services/data/

# Artifacts and runs (generated at runtime)
/artifacts/
/runs/
# THE CONTENTS RATHER THAN THE DIRECTORY, so the negation below can take
# effect. Git does not descend into an excluded DIRECTORY, so `/corpus/`
# followed by `!/corpus/traits/` re-includes nothing at all -- the files stay
# invisible and the negation reads as though it works.
/corpus/*

# Allow the AUTHORED trait corpora. Everything else under /corpus/ is
# downloaded or generated bulk, which is why that directory is ignored; these
# four files are hand-written source that the measurement is DEFINED by. The
# plan table's declared effect is derived from their pair count, a suite reads
# them to check that derivation still holds, and tools/hpc3/runs stages them
# with a sha256 each -- none of which works from a file that exists only on
# one machine. (2026-09-11)
#
# THE SECOND LINE IS NOT REDUNDANT. `*.json` above hides every JSON file in
# this service, so re-including the directory alone leaves its four files
# invisible -- which is exactly how `!results/cartridge/*.json` a few lines up
# had to be written too.
!/corpus/traits/
!/corpus/traits/*.json

# Windows reserved paths that can sometimes appear due to tooling
nul
